# Discourse web/sidekiq shared env file (rendered by Ansible onto the host,
# chmod 0600). SECRET VALUES are injected from the vault at deploy time and
# never committed. This file on the host holds the real values.
DISCOURSE_HOSTNAME={{ discourse_force_hostname }}
RAILS_LOG_TO_STDOUT=1
UNICORN_WORKERS={{ discourse_unicorn_workers | default(2) }}

# DB (dedicated PostgreSQL 15 inside the same pod)
DISCOURSE_DB_HOST={{ discourse_postgres_container }}
DISCOURSE_DB_PORT={{ discourse_postgres_port }}
DISCOURSE_DB_NAME={{ discourse_db_name }}
DISCOURSE_DB_USER={{ discourse_db_user }}
DISCOURSE_DB_PASSWORD={{ discourse_db_password }}

# Redis (dedicated Redis 7 inside the same pod)
DISCOURSE_REDIS_HOST={{ discourse_redis_container }}
DISCOURSE_REDIS_PORT={{ discourse_redis_port }}
DISCOURSE_REDIS_DB={{ discourse_redis_db }}
DISCOURSE_REDIS_PASSWORD={{ discourse_redis_password }}

# SMTP (values from vault / relay; empty in dev until relay account exists)
DISCOURSE_SMTP_ADDRESS={{ discourse_smtp_address }}
DISCOURSE_SMTP_PORT={{ discourse_smtp_port }}
DISCOURSE_SMTP_AUTHENTICATION=plain
DISCOURSE_SMTP_OPENSSL_VERIFY_MODE=none
DISCOURSE_SMTP_USER_NAME={{ discourse_smtp_username }}
DISCOURSE_SMTP_PASSWORD={{ discourse_smtp_password }}
DISCOURSE_NOTIFICATION_EMAIL={{ discourse_notification_email }}

DISCOURSE_SKIP_EMAIL_SETUP={{ discourse_skip_email_setup }}
DISCOURSE_DEVELOPER_EMAILS={{ discourse_developer_emails }}

# Backups / tuning
DISCOURSE_BACKUP_LOCATION=local
DISCOURSE_MAXMIND_LICENSE_KEY=
